# Copy this file to .env and replace YOUR_PASSWORD with your PostgreSQL password.
# .env is in .gitignore, so your password never goes to GitHub.
#
# Both databases are created automatically. Their names must end in _day4 / _test:
# the code refuses to reset any other database, so your Day 3 data is safe.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/task_tracker_day4
TEST_DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/task_tracker_test
